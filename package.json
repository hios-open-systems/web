{
  "name": "hios-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/gen-blog-manifest.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/gen-blog-manifest.mjs",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start",
    "lint": "next lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "test:jwt": "node --experimental-strip-types scripts/jwt-selftest.ts",
    "test:calc": "node --experimental-strip-types scripts/calc-selftest.ts",
    "test:auth": "node --experimental-strip-types scripts/auth-selftest.ts",
    "test:hash": "node --experimental-strip-types scripts/hash-selftest.ts",
    "test:encoder": "node --experimental-strip-types scripts/encoder-selftest.ts",
    "test:ids": "node --experimental-strip-types scripts/ids-selftest.ts",
    "test:regex": "node --experimental-strip-types scripts/regex-selftest.ts",
    "test:textdiff": "node --experimental-strip-types scripts/textdiff-selftest.ts",
    "test:mermaid": "node --experimental-strip-types scripts/mermaid-selftest.ts",
    "test:notes": "node --experimental-strip-types scripts/notes-selftest.ts",
    "test:patterns": "node --experimental-strip-types scripts/patterns-selftest.ts",
    "test:themes": "node --experimental-strip-types scripts/themes-selftest.ts",
    "test:usage": "node --experimental-strip-types scripts/usage-selftest.ts",
    "gen:icons": "node --experimental-strip-types scripts/gen-icons.ts",
    "test:wiring": "node --experimental-strip-types scripts/wiringguide-selftest.ts",
    "test:breakouts": "node --experimental-strip-types scripts/breakouts-selftest.ts",
    "test:padwebui": "node projects/pad/test/webui-selftest.cjs",
    "test:resistor": "node --experimental-strip-types scripts/resistor-selftest.ts",
    "test:ohms": "node --experimental-strip-types scripts/ohms-selftest.ts",
    "test:httpstatus": "node --experimental-strip-types scripts/httpstatus-selftest.ts",
    "test:charset": "node --experimental-strip-types scripts/charset-selftest.ts",
    "test:notefreq": "node --experimental-strip-types scripts/notefreq-selftest.ts",
    "test:ipv6": "node --experimental-strip-types scripts/ipv6-selftest.ts",
    "test:hmac": "node --experimental-strip-types scripts/hmac-selftest.ts",
    "test:csvjson": "node --experimental-strip-types scripts/csvjson-selftest.ts",
    "test:tuning": "node --experimental-strip-types scripts/tuning-selftest.ts",
    "test:pitch": "node --experimental-strip-types scripts/pitch-selftest.ts",
    "db:migrate": "wrangler d1 migrations apply hios-playground --remote",
    "db:migrate:local": "wrangler d1 migrations apply hios-playground --local",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:auth": "playwright test -c playwright.cloudflare.config.ts"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.18.0",
    "@ant-design/icons": "^5.2.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@lmstudio/sdk": "^1.5.0",
    "antd": "^5.14.0",
    "clsx": "^2.1.0",
    "framer-motion": "^12.29.0",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.16.0",
    "next": "^15.5.20",
    "next-intl": "^4.7.0",
    "next-mdx-remote": "^4.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260718.1",
    "@eslint/eslintrc": "^3.3.6",
    "@opennextjs/cloudflare": "^1.20.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.11",
    "@types/three": "^0.169.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "wrangler": "^4.112.0"
  }
}
