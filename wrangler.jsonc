{
  // Config de Cloudflare Workers para el deploy vía @opennextjs/cloudflare.
  // Reemplaza al wrangler.toml (modelo Pages). El binding D1 y las vars no-secretas
  // se mantienen; el GITHUB_CLIENT_SECRET va como Secret del Worker (dashboard).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hios-platform",
  "account_id": "74517853847d3bfb25721012cf268858",
  "workers_dev": false,
  "preview_urls": false,
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "GITHUB_CLIENT_ID": "Ov23licdOWRnG6AVSnyR",
    "AUTH_BASE_URL": "https://openhios.dev",
    "ADMIN_GITHUB_ID": "37183343"
  },
  "ratelimits": [
  {
    "name": "RATE_LIMIT_3",
    "namespace_id": "2026102400",
    "simple": {
      "limit": 3,
      "period": 60
    }
  },
  {
    "name": "RATE_LIMIT_5",
    "namespace_id": "2026102401",
    "simple": {
      "limit": 5,
      "period": 60
    }
  },
  {
    "name": "RATE_LIMIT_10",
    "namespace_id": "2026102402",
    "simple": {
      "limit": 10,
      "period": 60
    }
  },
  {
    "name": "RATE_LIMIT_20",
    "namespace_id": "2026102403",
    "simple": {
      "limit": 20,
      "period": 60
    }
  },
  {
    "name": "RATE_LIMIT_30",
    "namespace_id": "2026102404",
    "simple": {
      "limit": 30,
      "period": 60
    }
  },
  {
    "name": "RATE_LIMIT_60",
    "namespace_id": "2026102405",
    "simple": {
      "limit": 60,
      "period": 60
    }
  },
  {
    "name": "RATE_LIMIT_120",
    "namespace_id": "2026102406",
    "simple": {
      "limit": 120,
      "period": 60
    }
  }
],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hios-playground",
      "database_id": "a3b55142-933d-451e-aa95-21eb1231516a",
      "migrations_dir": "migrations"
    }
  ],
  // Preserve diagnostics without storing OAuth codes or user input in URL queries.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true
  }
}
